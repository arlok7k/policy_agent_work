FROM python:3.15.2-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/backend \
    PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /app
COPY requirements.lock ./
RUN python -m pip install --no-cache-dir --require-hashes -r requirements.lock \
    && groupadd --gid 10001 soc && useradd --uid 10001 --gid soc --no-create-home soc
COPY --chown=10001:10001 alembic.ini ./
COPY --chown=10001:10001 backend/app ./backend/app
COPY --chown=10001:10001 backend/migrations ./backend/migrations
COPY --chown=10001:10001 scripts/provision_runtime.py scripts/seed_dev.py ./scripts/
USER 10001:10001
EXPOSE 8000
CMD ["gunicorn", "--worker-class", "app.core.gunicorn_worker.HostUvicornWorker", "--bind", "0.0.0.0:8000", "--workers", "2", "app.main:app"]
