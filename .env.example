# Copy to a non-committed environment file and export the variables.
# Provision the referenced files outside the repository. No secret values here.
ENV=development
DATABASE_URL_FILE=/run/secrets/database_url
SESSION_SIGNING_SECRET_FILE=/run/secrets/session_signing_secret
# Operator-reviewed example policies; the application does not supply defaults.
SESSION_TTL_SECONDS=28800
LOGIN_FAILURE_LIMIT=5
LOGIN_WINDOW_SECONDS=60
PASSWORD_MIN_CHARS=14
PASSWORD_MAX_CHARS=1024
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=100
USERNAME_MAX_CHARS=128
API_KEY_NAME_MAX_CHARS=128
MAX_API_KEY_TTL_SECONDS=2592000

# PB2 webhook and separately provisioned Redis broker and cache instances.
WEBHOOK_SECRET_FILE=/run/secrets/webhook_secret
WEBHOOK_INITIATOR=service:alert-webhook
WEBHOOK_MAX_BODY_BYTES=262144
WEBHOOK_MAX_FIELD_CHARS=512
WEBHOOK_MAX_CLOCK_SKEW_SECONDS=300
REDIS_TIMEOUT_SECONDS=2
THREAT_INTEL_TIMEOUT_SECONDS=2
THREAT_INTEL_CACHE_TTL_SECONDS=3600
THREAT_INTEL_BULK_MAX_ITEMS=100
INCIDENT_MAX_ALERTS=100
INCIDENT_MAX_TEXT_CHARS=4096
THROTTLE_CLEANUP_INTERVAL_SECONDS=300
THROTTLE_CLEANUP_BATCH_SIZE=500
THROTTLE_CLEANUP_INITIATOR=service:throttle-cleanup
CELERY_BROKER_URL_FILE=/run/secrets/celery_broker_url
REDIS_CACHE_URL_FILE=/run/secrets/redis_cache_url

# For development seeding, supply SEED_ADMIN_PASSWORD, SEED_SENIOR_ANALYST_PASSWORD,
# and SEED_ANALYST_PASSWORD securely via the environment; no defaults are provided.
