# Copy to a non-committed environment file and export the variables.
# Provision the referenced files outside the repository. No secret values here.
ENV=development
DATABASE_URL_FILE=/run/secrets/database_url
SESSION_SIGNING_SECRET_FILE=/run/secrets/session_signing_secret
# Operator-reviewed example policies; the application does not supply defaults.
SESSION_TTL_SECONDS=28800
LOGIN_FAILURE_LIMIT=5
LOGIN_WINDOW_SECONDS=60
PASSWORD_MIN_CHARS=14
PASSWORD_MAX_CHARS=1024
